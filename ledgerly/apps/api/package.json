    "@ledgerly/contracts": "workspace:*",
    "@ledgerly/domain": "workspace:*",
    "@nestjs/common": "11.1.9",
    "@nestjs/core": "11.1.9",
    "@nestjs/platform-fastify": "11.1.9",
    "@nestjs/swagger": "11.2.3",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.9",
    "@types/pg": "8.15.6",
