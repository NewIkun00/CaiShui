{
  "name": "ledgerly",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm openapi:check && pnpm r5:acceptance:test && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "openapi:generate": "pnpm --filter @ledgerly/domain build && pnpm --filter @ledgerly/contracts build && pnpm --filter @ledgerly/api build && node tools/generate-openapi.mjs && openapi-typescript openapi/openapi.json -o packages/api-client/src/generated.ts --immutable --alphabetize",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- openapi/openapi.json packages/api-client/src/generated.ts",
    "db:generate": "pnpm --filter @ledgerly/api db:generate",
    "db:migrate": "pnpm --filter @ledgerly/api db:migrate",
    "identity:seed-admin": "pnpm --filter @ledgerly/api identity:seed-admin",
    "r5:acceptance:doctor": "node tools/r5-acceptance/cli.mjs doctor",
    "r5:acceptance:simulate": "node tools/r5-acceptance/cli.mjs simulate",
    "r5:acceptance:start": "node tools/r5-acceptance/cli.mjs start",
    "r5:acceptance:run": "node tools/r5-acceptance/cli.mjs run",
    "r5:acceptance:stop": "node tools/r5-acceptance/cli.mjs stop",
    "r5:acceptance:test": "node --test tools/r5-acceptance/test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "openapi-typescript": "7.12.0",
    "prettier": "3.6.2",
    "turbo": "2.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.8"
  }
}
