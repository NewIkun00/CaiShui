R5_POSTGRES_PASSWORD=replace-with-a-long-test-password
R5_KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-test-password
R5_KEYCLOAK_ADMIN=ledgerly-admin
R5_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-admin-password
R5_OIDC_ADMIN_CLIENT_SECRET=replace-with-a-random-client-secret
R5_ALICE_EMAIL=alice@example.test
R5_ALICE_PASSWORD=replace-with-a-long-alice-password
R5_BOB_EMAIL=bob@example.test
R5_BOB_PASSWORD=replace-with-a-long-bob-password
R5_AUTH_COOKIE_KEY=replace-with-32-byte-base64-value

# Ports may be changed when the defaults are occupied.
R5_POSTGRES_PORT=55432
R5_KEYCLOAK_DB_PORT=55433
R5_KEYCLOAK_HTTPS_PORT=58443
R5_KEYCLOAK_MANAGEMENT_PORT=59000
R5_MAILPIT_SMTP_PORT=51025
R5_MAILPIT_HTTP_PORT=58080
R5_API_PORT=3001
R5_WEB_PORT=3020
