DATABASE_URL=postgresql://ledgerly:ledgerly@localhost:5432/ledgerly
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=cn-east-1
S3_ACCESS_KEY=ledgerly
S3_SECRET_KEY=change-me-in-local-env
S3_BUCKET=ledgerly-local
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
AUTH_MODE=development-headers
NEXT_PUBLIC_AUTH_MODE=development-headers
# development-headers 只允许与非生产 memory 模式一起使用；生产环境禁止。
STORAGE_MODE=memory
# 切换 AUTH_MODE=oidc 时必须配置以下值，并可使用 STORAGE_MODE=postgres：
# OIDC_ISSUER=https://identity.example.com/realms/ledgerly
# OIDC_CLIENT_ID=ledgerly-web
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:3020/auth/callback
# AUTH_COOKIE_KEY=请替换为随机32字节的Base64值
# Provider 会话联动撤销所需的最小权限服务账号（生产必配）：
# OIDC_ADMIN_CLIENT_ID=ledgerly-session-revoker
# OIDC_ADMIN_CLIENT_SECRET=
LOCAL_OBJECT_STORAGE_DIR=.data/private-objects
